# ============================================================
# SIAGA — root environment overrides for Docker Compose (optional).
#
# Copy this file to `.env` and adjust values to override the defaults
# baked into compose.yaml. All values below are the defaults.
#
#   Copy-Item .env.example .env
# ============================================================

# Application
APP_NAME=SIAGA
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# Docker host ports (change here if a port is already in use on your machine)
BACKEND_PORT=8000
FRONTEND_PORT=5173
DB_PORT=5432

# Database (PostgreSQL + TimescaleDB)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=siaga_db
DB_USERNAME=postgres
DB_PASSWORD=password

# Cache & Session (database-backed, no Redis required by SIAGA MVP)
CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database