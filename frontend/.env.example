# Konfigurasi environment Vite (nilai opsional; bawaan pada src/config/env.js)
# Salin file ini menjadi .env bila perlu override.

# Base path REST API backend (bawaan: /api/v1)
VITE_API_BASE_URL=/api/v1

# Timeout request API dalam ms (bawaan: 10000)
VITE_API_TIMEOUT=10000

# Interval polling data terkini dalam ms (bawaan: 5000)
VITE_POLLING_INTERVAL=5000

# Default per_page untuk request pagination (bawaan: 50)
VITE_DEFAULT_PER_PAGE=50

# per_page untuk daftar device (bawaan: 50)
VITE_DEVICES_PER_PAGE=50

# Ambang waktu (ms) sejak last_seen_at untuk menandai device stale (bawaan: 60000)
VITE_STALE_THRESHOLD_MS=60000

# Target proxy dev Vite -> backend Laravel (bawaan: http://127.0.0.1:8000)
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000
